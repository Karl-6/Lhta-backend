# رابط قاعدة بيانات PostgreSQL - يوفره Render تلقائيًا بعد إنشاء قاعدة بيانات
DATABASE_URL=postgres://user:password@host:5432/dbname

# نص عشوائي طويل لتشفير الجلسات (Session) - غيّره لأي نص عشوائي قبل النشر
SESSION_SECRET=غيّر_هذا_النص_قبل_النشر

# كلمة مرور دخول لوحة المشرف
ADMIN_PASSWORD=Aneslht202700

# رابط الواجهة الأمامية (موقعك المنشور) - يُستخدم لإعادة التوجيه بعد تسجيل الدخول عبر Google/Facebook
FRONTEND_URL=https://your-frontend-url.com

# بيانات تطبيق Google OAuth (من console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-backend-url.onrender.com/api/auth/google/callback

# بيانات تطبيق Facebook Login (من developers.facebook.com)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://your-backend-url.onrender.com/api/auth/facebook/callback

PORT=3000
